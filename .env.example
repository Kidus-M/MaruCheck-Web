# Neon pooled connection string for the Next.js application.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon direct connection string for Drizzle migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Generate with: npx auth secret
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Vercel Production must use: BETTER_AUTH_URL=https://marucheck.dev

# Invited production access is locked by default. Use a comma-separated allowlist,
# or explicitly opt into open registration. Local development remains open by default.
MARUCHECK_ALLOWED_SIGNUP_EMAILS=owner@example.com,tester@example.com
MARUCHECK_OPEN_SIGNUPS=false

# Generate a separate high-entropy value for Vercel Cron authentication.
CRON_SECRET=replace-with-a-separate-32-character-random-value

# Optional GitHub sign-in and repository discovery. Email/password remains available without these.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Google sign-in. Configure the matching Better Auth callback URL in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
