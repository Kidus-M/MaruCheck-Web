{
  "name": "maru-web",
  "version": "0.1.0",
  "private": true,
  "description": "MaruCheck hosted dashboard and API",
  "license": "MIT",
  "type": "module",
  "homepage": "https://maru-check.vercel.app/",
  "bugs": {
    "url": "https://github.com/Kidus-M/MaruCheck-Web/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kidus-M/MaruCheck-Web.git"
  },
  "scripts": {
    "auth:generate": "npx --yes auth@1.7.0 generate --config better-auth.config.ts --output src/db/schema/auth.ts --yes",
    "deploy:env:check": "node scripts/verify-production-env.ts",
    "deploy:smoke": "node scripts/smoke-deployment.mjs",
    "build": "next build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "next dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/verify-database-env.mjs && drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "feedback:prune": "node scripts/prune-production-feedback.mjs",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run --configLoader native --pool=threads",
    "test:e2e": "playwright test",
    "test:integration": "node scripts/verify-test-database-env.mjs && vitest run --config vitest.integration.config.ts --configLoader native --pool=threads",
    "test:watch": "vitest --configLoader native --pool=threads",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.7.0",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "marucheck": "0.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
